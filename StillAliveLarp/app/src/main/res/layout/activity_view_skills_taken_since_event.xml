<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_gray"
    tools:context=".views.account.admin.ViewSkillsTakenSinceEventActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:id="@+id/skillstakensince_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Skills Taken Since: Event"
                android:textStyle="bold"
                android:textSize="32sp"
                android:textAlignment="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/skillstakensince_searchview"
                    android:layout_width="0px"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:hint="Search"
                    android:textSize="24sp"
                    android:layout_gravity="center"
                    android:layout_marginRight="16dp"
                    android:layout_weight="4"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <CheckBox
                    android:id="@+id/skillstakensince_includeFreeSkills"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textAlignment="textStart"
                    android:layout_weight="1"
                    android:text="Include Free Skills"/>
                <CheckBox
                    android:id="@+id/skillstakensince_includePlayers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textAlignment="textStart"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Include Players"/>
                <CheckBox
                    android:id="@+id/skillstakensince_includeNPCs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textAlignment="textStart"
                    android:layout_weight="1"
                    android:text="Include NPCs"/>
                <CheckBox
                    android:id="@+id/skillstakensince_includeDead"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:textAlignment="textStart"
                    android:layout_weight="1"
                    android:text="Include Dead"/>
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/keyvalueview_div"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:id="@+id/skillstakensince_innerlayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                </LinearLayout>


            </ScrollView>

        </LinearLayout> <!-- BEFORE THIS ONE-->

    </ScrollView>

</LinearLayout>